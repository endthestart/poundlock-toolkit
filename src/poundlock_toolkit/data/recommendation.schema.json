{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:poundlock-toolkit:recommendation:1",
  "title": "Poundlock Toolkit recommendation summary",
  "description": "Output of `poundlock-toolkit recommend --format json`. Toolkit's verdicts as data for other programs. Version 1 only gains optional fields; a breaking change gets a new schema URN.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "toolkit_version", "evaluated_at", "results", "investigation_pairs"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "level": {"enum": ["repeated task qualification", "observed smoke pass", "insufficient evidence"]},
    "count": {"type": "integer", "minimum": 0},
    "reasoning_sent": {
      "enum": ["omitted", "disabled", "low", "medium", "high", null],
      "description": "What the measured requests told the server about thinking: omitted (nothing sent, so the model's default applied), disabled (an explicit off), or the effort level sent. null in a tool-schema result's settings, where each boundary reports its own, or when no settings were recorded."
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "passed", "attempted"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "passed": {"$ref": "#/$defs/count"},
        "attempted": {"$ref": "#/$defs/count"}
      }
    }
  },
  "properties": {
    "schema": {"const": "urn:poundlock-toolkit:recommendation:1"},
    "toolkit_version": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time", "description": "Freshness is judged against this time."},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_schema", "run_id", "result_sha256", "identity_sha256", "created_at", "toolkit_version", "synthetic", "harness", "settings", "investigation_variant", "workloads", "tool_schema"],
        "properties": {
          "result_schema": {"enum": ["urn:poundlock-toolkit:qualification:1", "urn:poundlock-toolkit:tool-schema:1"]},
          "run_id": {"type": "string", "minLength": 1},
          "result_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the canonical JSON of the exported result document."},
          "identity_sha256": {"$ref": "#/$defs/sha256"},
          "created_at": {"type": "string", "format": "date-time"},
          "toolkit_version": {"type": "string", "minLength": 1, "description": "The Toolkit version that measured this result."},
          "synthetic": {"type": ["boolean", "null"], "description": "null for tool-schema results."},
          "harness": {"type": "string", "minLength": 1, "description": "\"direct\" for tool-schema results."},
          "settings": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["context_tokens", "max_output_tokens", "reasoning", "reasoning_sent"],
                "properties": {
                  "context_tokens": {"type": "integer", "minimum": 1},
                  "max_output_tokens": {"type": "integer", "minimum": 1},
                  "reasoning": {"enum": ["off", "low", "medium", "high"], "description": "As configured."},
                  "reasoning_sent": {"$ref": "#/$defs/reasoning_sent"}
                }
              }
            ]
          },
          "investigation_variant": {"enum": ["findable", "absent", null]},
          "workloads": {
            "type": "array",
            "description": "Empty for tool-schema results.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["workload", "level", "passed", "attempted", "planned", "next_required_check"],
              "properties": {
                "workload": {"enum": ["extraction", "coding", "investigation"]},
                "level": {"$ref": "#/$defs/level"},
                "passed": {"$ref": "#/$defs/count"},
                "attempted": {"$ref": "#/$defs/count"},
                "planned": {"$ref": "#/$defs/count"},
                "next_required_check": {"type": ["string", "null"]}
              }
            }
          },
          "tool_schema": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "boundaries"],
                "properties": {
                  "mode": {"enum": ["smoke", "qualification"]},
                  "boundaries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["boundary", "planned", "attempted", "passed", "reasoning_sent"],
                      "properties": {
                        "boundary": {"enum": ["openai", "ollama"]},
                        "reasoning_sent": {"$ref": "#/$defs/reasoning_sent"},
                        "planned": {"$ref": "#/$defs/count"},
                        "attempted": {"$ref": "#/$defs/count"},
                        "passed": {"$ref": "#/$defs/count"}
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "investigation_pairs": {
      "type": "array",
      "description": "Both investigation variants measured against one identity; the newest run of each variant is used. Qualified only when both variants independently reach repeated task qualification.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_sha256", "findable_run_id", "absent_run_id", "qualified", "findable", "absent"],
        "properties": {
          "identity_sha256": {"$ref": "#/$defs/sha256"},
          "findable_run_id": {"type": "string", "minLength": 1},
          "absent_run_id": {"type": "string", "minLength": 1},
          "qualified": {"type": "boolean"},
          "findable": {"$ref": "#/$defs/verdict"},
          "absent": {"$ref": "#/$defs/verdict"}
        }
      }
    }
  }
}
